# ============================================================================
# NexusTrade AI - Environment Configuration Template
# Copy this file to .env and populate with your credentials
# ============================================================================

# Application Environment
APP_NAME=NexusTrade AI
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON_FORMAT=false
DATA_DIR=data

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=1234567890:AAH_your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
TELEGRAM_ADMIN_CHAT_ID=123456789
TELEGRAM_RATE_LIMIT_CALLS=5
TELEGRAM_RATE_LIMIT_PERIOD=10.0
TELEGRAM_ADMIN_USER_IDS=123456789
TELEGRAM_OPEN_ACCESS=false

# TradingView Webhook & Charting Configuration
TRADINGVIEW_WEBHOOK_SECRET=your_encrypted_webhook_secret_here
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
CHART_WIDTH=1200
CHART_HEIGHT=800

# Kaggle API Credentials
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# AI Engine & Ensemble Weights
ENSEMBLE_TECH_WEIGHT=0.65
ENSEMBLE_SENT_WEIGHT=0.35
SIGNAL_CONFIDENCE_THRESHOLD=0.72
FINBERT_MODEL_NAME=ProsusAI/finbert
USE_TRANSFORMERS_PIPELINE=false

# Institutional Risk Guardrails
PORTFOLIO_INITIAL_CAPITAL=100000.0
MAX_ACCOUNT_RISK_PER_TRADE=0.015
ATR_STOP_LOSS_MULTIPLIER=2.0
MIN_RISK_REWARD_RATIO=2.0
MAX_DAILY_DRAWDOWN_LIMIT=0.04
MAX_VOLATILITY_THRESHOLD=0.85

# Admin-Only Binance API & Multi-User Vault Configuration
# Note: BINANCE_API_KEY and BINANCE_API_SECRET in .env apply ONLY to Admin users.
# Regular users MUST configure their personal Binance account via /setup in Telegram.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
VAULT_ENCRYPTION_SECRET=change_this_to_a_strong_32_char_vault_master_secret

# --- Real-Time News & Macro Providers ---
FINNHUB_API_KEY="your_finnhub_api_key_here"
ALPHAVANTAGE_API_KEY="your_alphavantage_api_key_here"

# Public Zero-Key Feeds (ForexFactory, MarcToMarket & Tier-1 Crypto RSS)
FOREXFACTORY_CALENDAR_URL="https://nfs.faireconomy.media/ff_calendar_thisweek.json"
MARCTOMARKET_FEED_URL="https://www.marctomarket.com/feeds/posts/default?alt=json"
CRYPTO_RSS_FEEDS="https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://decrypt.co/feed,https://www.theblock.co/rss.xml"

# Polling & Cache TTLs (Seconds)
TTL_FOREXFACTORY=3600
TTL_MARCTOMARKET=1800
TTL_FINNHUB=120
TTL_ALPHAVANTAGE=1800
TTL_CRYPTO_RSS=60
